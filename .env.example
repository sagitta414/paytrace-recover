PORT=4358
PUBLIC_URL=http://127.0.0.1:4358
DATABASE_PATH=./data/courselatch.sqlite
# A passing technical proof is current for five minutes by default (60–3600 seconds).
# VERIFICATION_MAX_AGE_SECONDS=300
# AUDIT_HMAC_KEY=  # Stable private value, at least 32 characters
# Verified merchant mode. In production this mode is mandatory and fails closed
# unless OIDC and the separate course connector are configured.
# AUTH_REQUIRED=true
# OIDC_ISSUER=https://your-identity-provider.example
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REQUIRE_MFA=true
# OIDC_MFA_ACR=
# BOOTSTRAP_ADMIN_EMAILS=owner@example.com
# OIDC_ACCOUNT_URL=https://your-identity-provider.example/account
# Optional encrypted backup commands: generate a private random 32-byte key, encode it as base64, and keep it out of Git.
# BACKUP_ENCRYPTION_KEY=
# BACKUP_DIR=./data/backups
# BACKUP_KEEP=7
# PayPal sandbox ONLY. Never enter production PayPal credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional event-driven sandbox intake. Use the webhook ID from the same PayPal app.
PAYPAL_WEBHOOK_ID=
# Optional separate course service for sandbox purchases. Run the reference service
# locally or supply an HTTPS service implementing docs/COURSE-ACCESS.md.
COURSE_ACCESS_URL=
COURSE_ACCESS_API_KEY=
# Optional AI: set an available Responses API model explicitly.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional Azure OpenAI v1 endpoint, for example https://RESOURCE.openai.azure.com/openai/v1/
# Leave blank for api.openai.com. Use the Azure deployment name in OPENAI_MODEL.
OPENAI_BASE_URL=
# Optional Azure Application Insights export. Leave blank for local/offline runs.
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Optional Render Workflows. Set on both web service and workflow service.
WORKFLOW_SECRET=
APP_URL=
# Web service only:
RENDER_API_KEY=
RENDER_INVESTIGATE_TASK=
RENDER_RECOVER_TASK=
# Required to enable sandbox/AI actions. Keep server-side; enter in the demo session panel.
DEMO_OPERATOR_KEY=
# Optional customer notification email (server-only, verified sender required).
RESEND_API_KEY=
EMAIL_FROM=
