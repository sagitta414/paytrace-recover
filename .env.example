PORT=4358
PUBLIC_URL=http://127.0.0.1:4358
DATABASE_PATH=./data/courselatch.sqlite
# PayPal sandbox ONLY. Never enter production PayPal credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional AI: set an available Responses API model explicitly.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional Render Workflows. Set on both web service and workflow service.
WORKFLOW_SECRET=
APP_URL=
# Web service only:
RENDER_API_KEY=
RENDER_INVESTIGATE_TASK=
RENDER_RECOVER_TASK=
# Required to enable sandbox/AI actions. Keep server-side; enter in the demo session panel.
DEMO_OPERATOR_KEY=
# Optional customer notification email (server-only, verified sender required).
RESEND_API_KEY=
EMAIL_FROM=

# Pending workflow expiry, seconds (60-3600). Default: 15 minutes.
WORKFLOW_TIMEOUT_SECONDS=900

# Optional verified PayPal sandbox webhook listener.
PAYPAL_WEBHOOK_ID=
# Stable server-only audit integrity key, 32+ characters. Keep external checkpoints.
AUDIT_HMAC_KEY=

# Verified merchant accounts. Set AUTH_REQUIRED=true when configuring OIDC sign-in.
# NODE_ENV=production always requires sign-in, MFA, a course connector and protection settings.
AUTH_REQUIRED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REQUIRE_MFA=true
OIDC_MFA_ACR=
OIDC_ACCOUNT_URL=
BOOTSTRAP_ADMIN_EMAILS=
# HTTPS course bridge implementing docs/COURSE-CONNECTOR.md.
COURSE_API_URL=
COURSE_API_TOKEN=
COURSE_ID=course-light
COURSE_NAME=The Light & Story Workshop
COURSE_AMOUNT_MINOR=12800
COURSE_CURRENCY=USD
VERIFICATION_MAX_AGE_SECONDS=300
# Durable workers run in the web process by default; optional same-host worker: npm run worker.
BACKGROUND_JOBS=true
BACKUP_DIR=./data/backups
BACKUP_KEEP=7
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BACKUP_ENCRYPTION_KEY=
AUDIT_CHECKPOINT_DIR=./data/checkpoints
AUDIT_CHECKPOINT_URL=
AUDIT_CHECKPOINT_TOKEN=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
LIVE_ACCEPTANCE_REPORT=
# Opt-in live test inputs; keep real fixtures under ignored private/ outside published assets.
RUN_LIVE_ACCEPTANCE=0
LIVE_CASE_FILE=
LIVE_WEBHOOK_FILE=
LIVE_WORKSPACE_ID=
LIVE_EXPECTED_STATUS=COMPLETED
