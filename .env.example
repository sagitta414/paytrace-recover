PORT=4358
PUBLIC_URL=http://127.0.0.1:4358
DATABASE_PATH=./data/courselatch.sqlite
# PayPal sandbox ONLY. Never enter production PayPal credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional event-driven sandbox intake. Use the webhook ID from the same PayPal app.
PAYPAL_WEBHOOK_ID=
# Optional separate course service for sandbox purchases. Run the reference service
# locally or supply an HTTPS service implementing docs/COURSE-ACCESS.md.
COURSE_ACCESS_URL=
COURSE_ACCESS_API_KEY=
# Optional AI: set an available Responses API model explicitly.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional Render Workflows. Set on both web service and workflow service.
WORKFLOW_SECRET=
APP_URL=
# Web service only:
RENDER_API_KEY=
RENDER_INVESTIGATE_TASK=
RENDER_RECOVER_TASK=
# Required to enable sandbox/AI actions. Keep server-side; enter in the demo session panel.
DEMO_OPERATOR_KEY=
# Optional customer notification email (server-only, verified sender required).
RESEND_API_KEY=
EMAIL_FROM=
