{
 "name": "courselatch",
 "private": true,
 "version": "0.1.0",
 "type": "module",
 "engines": {
  "node": ">=24"
 },
 "scripts": {
  "start": "node --env-file-if-exists=.env --import ./server/telemetry-bootstrap.mjs server/index.mjs",
  "dev": "node --env-file-if-exists=.env --import ./server/telemetry-bootstrap.mjs server/index.mjs",
  "test": "node --test --test-concurrency=1 tests/*.test.mjs",
  "workflows": "node workflows/index.mjs",
  "ai:smoke": "node scripts/ai-smoke.mjs",
  "ai:eval": "node scripts/ai-eval.mjs",
  "course:smoke": "node scripts/course-smoke.mjs"
 },
 "dependencies": {
  "@microsoft/opentelemetry": "^1.5.0",
  "@opentelemetry/api": "^1.9.1",
  "@renderinc/sdk": "^1.0.0"
 }
}
