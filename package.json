{
  "name": "courselatch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "workflows": "node workflows/index.mjs",
    "worker": "node --env-file-if-exists=.env server/worker.mjs",
    "restore": "node --env-file-if-exists=.env server/restore.mjs",
    "test:live": "node --env-file-if-exists=.env --test tests/live/*.test.mjs"
  },
  "dependencies": {
    "@renderinc/sdk": "^1.0.0",
    "jose": "^6.2.13"
  }
}
